PORT=3333
# PostgreSQL (Neon/Supabase gratuitos). Sem DATABASE_URL os feedbacks ficam só em memória.
DATABASE_URL=
# Origens do widget autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
MAX_SCREENSHOT_MB=4
# SMTP (ex.: Mailtrap). Sem MAIL_HOST/MAIL_TO o e-mail só é registrado no console.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Equipe Feedget <oi@feedget.com>
MAIL_TO=
