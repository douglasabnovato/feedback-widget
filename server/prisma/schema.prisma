// Schema Prisma do Feedget (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Feedback {
  id         String   @id @default(uuid())
  type       String
  comment    String
  screenshot String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("feedbacks")
}
